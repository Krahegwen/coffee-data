{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "coffee-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",
  "observability": { "enabled": true },

  // Las Preview URLs publican una URL por versión desplegada. No hacen falta
  // y multiplican la superficie expuesta, así que fuera.
  "preview_urls": false,

  // Dominio propio, y workers.dev apagado: el subdominio workers.dev de la
  // cuenta se generó a partir del correo y lleva el nombre real dentro, así
  // que no puede ser la URL que acabe incrustada en la app.
  "workers_dev": false,
  "routes": [{ "pattern": "brew.krahegwen.com", "custom_domain": true }],

  // La app y la API viven en el mismo origen: un Worker sirve las dos cosas.
  // Eso elimina CORS de raíz y deja la puerta abierta a guardar el token en
  // una cookie httpOnly en lugar de en localStorage.
  //
  // run_worker_first manda /api/* al script; lo demás sale de los estáticos, y
  // lo que no exista cae en index.html porque la app enruta en el cliente.
  "assets": {
    "directory": "../web/.output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffee",
      "database_id": "de776103-1a8f-45a0-8b7b-3c4b6aec74c5",
      "migrations_dir": "migrations"
    }
  ],

  // Las fotos de las bolsas. La columna cafes.foto guarda la clave del
  // objeto; el bucket no se expone: las sirve el Worker por /api/fotos/*.
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "coffee-fotos"
    }
  ]

  // TOKEN_ESCRITURA no va aquí: es un secreto.
  //   pnpm exec wrangler secret put TOKEN_ESCRITURA
  // Para local, ponlo en .dev.vars (ignorado por git).
}
