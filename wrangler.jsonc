{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coffee-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-05",
  "observability": { "enabled": true },

  // El binding es el nombre con el que el código ve la base: env.DB.
  // En local (--local, wrangler dev) usa un SQLite en .wrangler y el id da igual.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffee",
      "database_id": "de776103-1a8f-45a0-8b7b-3c4b6aec74c5",
      "migrations_dir": "migrations"
    }
  ]

  // TOKEN_ESCRITURA no va aquí: es un secreto.
  //   pnpm exec wrangler secret put TOKEN_ESCRITURA
  // Para local, ponlo en .dev.vars (ignorado por git).
}
