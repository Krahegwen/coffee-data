{
  "name": "coffee-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bitácora de extracciones de café: API en Workers y app instalable",
  "scripts": {
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @coffee/api dev",
    "dev:web": "pnpm --filter @coffee/web dev",
    "deploy:api": "pnpm --filter @coffee/api deploy",
    "db:local": "pnpm --filter @coffee/api db:local",
    "db:remoto": "pnpm --filter @coffee/api db:remoto"
  }
}
