#!/bin/sh
# Ejecuta los tests antes de cada commit y lo aborta si fallan.
# Activar tras clonar:  git config core.hooksPath hooks

PYTHON=""
for candidato in python3 python py; do
    if command -v "$candidato" >/dev/null 2>&1 && "$candidato" -c "import sys" >/dev/null 2>&1; then
        PYTHON="$candidato"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "pre-commit: no se encuentra Python. Commit abortado." >&2
    exit 1
fi

if ! "$PYTHON" -c "import pytest" >/dev/null 2>&1; then
    echo "pre-commit: falta pytest. Instálalo con: $PYTHON -m pip install pytest" >&2
    echo "pre-commit: commit abortado." >&2
    exit 1
fi

echo "pre-commit: ejecutando los tests de Python..."
if ! "$PYTHON" -m pytest -q; then
    echo "pre-commit: los tests de Python fallan. Commit abortado." >&2
    exit 1
fi

# El núcleo, la API y el almacén de la web se prueban con el runner que trae
# Node. Los de la web necesitan fake-indexeddb, que instala pnpm; Node lo
# resuelve subiendo desde el propio fichero de test, así que el glob funciona
# desde la raíz.
if [ -d nucleo/test ] || [ -d api/test ] || [ -d web/test ]; then
    if ! command -v node >/dev/null 2>&1; then
        echo "pre-commit: hay tests de Node pero no se encuentra Node. Commit abortado." >&2
        exit 1
    fi
    echo "pre-commit: ejecutando los tests del núcleo, la API y el almacén..."
    # Como globs y no como directorios: a node --test un directorio suelto le
    # parece un módulo que ejecutar, y revienta.
    if ! node --test "nucleo/test/*.test.js" "api/test/*.test.js" "web/test/*.test.js" >/dev/null; then
        echo "pre-commit: los tests de Node fallan. Commit abortado." >&2
        node --test --test-reporter=spec "nucleo/test/*.test.js" "api/test/*.test.js" "web/test/*.test.js" >&2
        exit 1
    fi
fi

# Al final y no al principio: un commit que no llega a hacerse no gasta
# versión. La sube el parche y entra en este mismo commit, que es lo que
# permite mirar el pie de la app y saber qué código tiene el móvil delante.
if ! "$PYTHON" herramientas/subir_version.py; then
    echo "pre-commit: commit abortado." >&2
    exit 1
fi
git add package.json nucleo/package.json api/package.json web/package.json
